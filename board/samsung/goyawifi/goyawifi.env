/*
 * Memory map (1 GiB LPDDR2 at 0x00000000):
 *   0x00000000 - 0x000fffff  OBM / boot ROM area        (do not touch)
 *   0x06000000 - 0x080fffff  CP carveout, HW protected  (do not touch)
 *   0x08100000 - 0x0817ffff  ramoops
 *   0x10008000               S-Boot load address of the "kernel" (us)
 *   0x17000000 - 0x17257fff  S-Boot splash / simple-framebuffer
 *   0x20000000 - 0x2fffffff  Linux CMA pool
 * U-Boot relocates itself to the top of DRAM, so after relocation the
 * 0x10000000 - 0x16ffffff window is free for kernel/fdt/initrd.
 */
kernel_addr_r=0x10008000
fdt_addr_r=0x11f00000
scriptaddr=0x11e00000
pxefile_addr_r=0x11d00000
ramdisk_addr_r=0x12000000
kernel_comp_addr_r=0x30000000
kernel_comp_size=0x2000000
fdtfile=pxa986-samsung-goyawifi.dtb
platform=pxa986

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

/*
 * lk2nd-style: a real Android boot.img (e.g. one packed for the goyawifi
 * 4.19 kernel with its appended DTB) may follow U-Boot in the KERNEL
 * partition, starting at 1 MiB. The kernel's appended DTB replaces r2, so we
 * just hand over our control DTB to keep bootm happy.
 */
goyawifi_bootimg_offset=0x800
goyawifi_bootimg_blocks=0x7800
boot_bootimg_addr=bootm ${loadaddr} - ${fdtcontroladdr}
boot_appended_bootimg=
	part start mmc 0 KERNEL kpart &&
	setexpr kblk ${kpart} + ${goyawifi_bootimg_offset} &&
	mmc dev 0 && mmc read ${loadaddr} ${kblk} ${goyawifi_bootimg_blocks} &&
	abootimg addr ${loadaddr} && run boot_bootimg_addr

/* "fastboot boot boot.img" */
fastboot_bootcmd=bootm 0x30000000 - ${fdtcontroladdr}

/*
 * EDK2 (edk2-goyawifi) chainload: the FD is linked to run at 0x10008000 and
 * starts with a zImage header, so bootz hands over with MMU/caches off.
 */
edk2_fd=GOYAWIFI_EFI.fd
boot_edk2=
	for dev in 1 0; do
		if load mmc ${dev}:1 ${kernel_addr_r} ${edk2_fd}; then
			bootz ${kernel_addr_r} - ${fdtcontroladdr};
		fi;
	done

bootmenu_0=Boot (SD card, eMMC, appended boot.img)=run bootcmd
bootmenu_1=UEFI firmware (EDK2, GOYAWIFI_EFI.fd)=run boot_edk2
bootmenu_2=Reboot to RECOVERY partition=reboot_recovery
bootmenu_3=USB mass storage (eMMC)=ums 0 mmc 0
bootmenu_4=Fastboot (USB)=fastboot usb 0
bootmenu_5=Reboot=reset
bootmenu_6=Power off=poweroff

bootcmd=
	if test "${goyawifi_key}" = "volup"; then reboot_recovery; fi;
	bootflow scan -lb; run boot_appended_bootimg; bootmenu
